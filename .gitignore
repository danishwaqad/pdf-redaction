# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
*.pem
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files - IMPORTANT
.env
.env.local
.env.development
.env.test
.env.production
.env*.local
backend/.env
.env.production.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# python backend
backend/.venv/
backend/**/__pycache__/
*.pyc

# API Keys & Secrets - EXTRA SAFETY (avoid broad *key* — it ignores files like keyword-hub-section.tsx)
*secret*
*.key
*.pem
config.json
config.js
secrets.json
firebase.json
google-services.json

# IDE
.vscode/
.idea/