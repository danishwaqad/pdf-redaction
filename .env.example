NEXT_PUBLIC_SITE_URL=https://redactpdf.org

# Google SEO & ads (add real values in Vercel → Environment Variables)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your_google_search_console_code
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_BANNER=

# Optional: Plausible instead of / alongside GA4
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=redactpdf.org

# Contact form (Resend → danishwaqad@gmail.com)
RESEND_API_KEY=re_your_key_here
RESEND_FROM=RedactPDF <onboarding@resend.dev>

# PyMuPDF redaction backend (FastAPI) — browser uploads DIRECTLY (not via Vercel).
# Local option A: npm run dev:api (leave REDACT_API_URL unset → uses http://127.0.0.1:8000)
# Local option B: test live Railway from localhost — set URL + KEY below, restart npm run dev
# REDACT_API_URL=https://your-app.up.railway.app
REDACT_API_URL=http://127.0.0.1:8000
# Production (Vercel): https://your-service.up.railway.app
# REDACT_API_KEY: py -3 -c "import secrets; print(secrets.token_hex(32))"
# Same secret on Railway + Vercel. Exposed to browser at build (required for direct upload).
REDACT_API_KEY=

# Optional overrides (default: same values as REDACT_API_* above via next.config.mjs)
# NEXT_PUBLIC_REDACT_API_URL=
# NEXT_PUBLIC_REDACT_API_KEY=
